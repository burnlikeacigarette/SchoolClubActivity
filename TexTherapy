// 입력 내용이 의미있는지 AI로 판별
async function isInputMeaningful(text) {
  if (!text || text.trim().length < 2) return false;
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 10,
        messages: [{
          role: 'user',
          content: `다음 텍스트가 사람의 감정, 생각, 고민을 담은 의미있는 내용인지 판단하세요. 단순 자음/모음 나열, 무의미한 반복, 테스트 문자는 "아니오"로 답하세요. "예" 또는 "아니오"만 출력하세요.\n\n텍스트: "${text.replace(/"/g,"'")}"`
        }]
      })
    });
    const data = await res.json();
    return data.content.map(b => b.text || '').join('').trim().includes('예');
  } catch(e) {
    return text.trim().length >= 10;
  }
}

