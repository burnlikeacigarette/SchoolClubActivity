<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TexTherapy (텍스트테라피)</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --pink-light: #FFE4EE;
    --pink-mid: #FFB6D3;
    --pink-deep: #E8749A;
    --mint-light: #D4F5EE;
    --mint-mid: #89DDD0;
    --mint-deep: #3BBFAD;
    --win-radius: 12px;
    --win-shadow: 0 8px 40px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.10);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Noto Sans KR', sans-serif;
    min-height: 100vh;
    background: linear-gradient(135deg, #FFE4EE 0%, #D4F5EE 30%, #FFB6D3 60%, #89DDD0 100%);
    background-size: 400% 400%;
    animation: bgShift 12s ease infinite;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 56px;
    overflow-x: hidden;
  }

  @keyframes bgShift {
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
  }

  /* Desktop icons */
  .desktop-icons {
    position: fixed;
    top: 24px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    z-index: 5;
  }
  .desktop-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    width: 64px;
  }
  .desktop-icon .icon-img {
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.7);
    border: 1.5px solid rgba(255,255,255,0.9);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    backdrop-filter: blur(4px);
    transition: transform 0.15s;
  }
  .desktop-icon:hover .icon-img { transform: scale(1.08); }
  .desktop-icon span {
    font-size: 11px;
    color: #444;
    text-shadow: 0 1px 3px rgba(255,255,255,0.8);
    text-align: center;
    word-break: keep-all;
  }

  /* Windows */
  .window {
    display: none;
    width: min(600px, 96vw);
    max-height: calc(100vh - 80px);
    background: #fff;
    border-radius: var(--win-radius);
    box-shadow: var(--win-shadow);
    border: 1.5px solid rgba(255,255,255,0.9);
    animation: winOpen 0.28s cubic-bezier(.22,1,.36,1);
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
  }
  .window.active { display: flex; flex-direction: column; }
  .win-titlebar { cursor: grab; flex-shrink: 0; }
  .win-titlebar:active { cursor: grabbing; }

  @keyframes winOpen {
    from { opacity:0; transform: scale(0.93) translateY(18px); }
    to   { opacity:1; transform: scale(1)   translateY(0); }
  }

  /* Window title bar */
  .win-titlebar {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: var(--win-radius) var(--win-radius) 0 0;
    gap: 10px;
    flex-shrink: 0;
  }
  .win-titlebar.pink  { background: linear-gradient(90deg, var(--pink-mid), var(--pink-light)); }
  .win-titlebar.teal  { background: linear-gradient(90deg, var(--mint-mid), var(--mint-light)); }
  .win-titlebar.blue  { background: linear-gradient(90deg, #a8d8f0, #ddf0fb); }

  .win-title { flex: 1; font-size: 13px; font-weight: 500; color: #444; }
  .win-btns  { display: flex; gap: 6px; }
  .win-btn {
    width: 14px; height: 14px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    font-size: 8px;
    display: flex; align-items: center; justify-content: center;
    color: rgba(0,0,0,0.45);
    font-weight: 700;
    transition: opacity 0.15s;
  }
  .win-btn:hover { opacity: 0.7; }
  .win-btn.minimize { background: #FBBF24; }
  .win-btn.maximize { background: #34D399; }
  .win-btn.close    { background: #F87171; }

  /* Window body */
  .win-body {
    padding: 20px 22px;
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .win-body::-webkit-scrollbar { width: 6px; }
  .win-body::-webkit-scrollbar-track { background: transparent; }
  .win-body::-webkit-scrollbar-thumb { background: #ddd; border-radius: 3px; }
  .win-body::-webkit-scrollbar-thumb:hover { background: #bbb; }

  /* ── SCREEN 1: Notepad ── */
  .notepad-lines {
    background: repeating-linear-gradient(#fff 0px, #fff 27px, #e3f0ff 28px);
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 12px 14px;
    min-height: 160px;
    position: relative;
  }
  .notepad-lines textarea {
    width: 100%;
    min-height: 140px;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 15px;
    line-height: 28px;
    color: #333;
  }
  .notepad-lines textarea::placeholder { color: #bbb; }

  /* NLP toggle banner */
  .nlp-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(90deg, #fff0f7, #e8faf6);
    border: 1.5px solid var(--pink-mid);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 14px;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .nlp-banner:hover { border-color: var(--pink-deep); }
  .nlp-banner .nlp-icon { font-size: 20px; }
  .nlp-banner .nlp-text { flex: 1; font-size: 13px; color: #555; line-height: 1.4; }
  .nlp-banner .nlp-text strong { color: var(--pink-deep); }
  .toggle-switch {
    width: 40px; height: 22px;
    background: #ddd;
    border-radius: 11px;
    position: relative;
    transition: background 0.25s;
    flex-shrink: 0;
  }
  .toggle-switch.on { background: var(--mint-deep); }
  .toggle-switch::after {
    content: '';
    width: 18px; height: 18px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 2px; left: 2px;
    transition: left 0.25s;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }
  .toggle-switch.on::after { left: 20px; }

  /* NLP modal */
  .nlp-modal-bg {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 200;
    align-items: center;
    justify-content: center;
  }
  .nlp-modal-bg.show { display: flex; }
  .nlp-modal {
    background: #fff;
    border-radius: 14px;
    padding: 24px 22px;
    width: min(420px, 92vw);
    box-shadow: 0 12px 48px rgba(0,0,0,0.2);
    animation: winOpen 0.22s cubic-bezier(.22,1,.36,1);
  }
  .nlp-modal h3 { font-size: 16px; margin-bottom: 10px; color: #333; }
  .nlp-modal p  { font-size: 13px; color: #666; line-height: 1.6; margin-bottom: 16px; }
  .nlp-modal-btns { display: flex; gap: 10px; justify-content: flex-end; }

  /* Buttons */
  .btn {
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: transform 0.12s, opacity 0.15s;
  }
  .btn:hover  { opacity: 0.88; }
  .btn:active { transform: scale(0.97); }
  .btn-pink  { background: linear-gradient(90deg, var(--pink-deep), var(--pink-mid)); color: #fff; }
  .btn-teal  { background: linear-gradient(90deg, var(--mint-deep), var(--mint-mid)); color: #fff; }
  .btn-blue  { background: linear-gradient(90deg, #4a9fd4, #7ec8e3); color: #fff; }
  .btn-ghost { background: transparent; border: 1.5px solid #ddd; color: #666; }
  .btn-exe {
    display: flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, #e8e8e8 0%, #f5f5f5 40%, #d8d8d8 100%);
    border: 2px solid;
    border-color: #fff #999 #999 #fff;
    color: #222;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 4px;
    box-shadow: 2px 2px 0 #aaa;
  }
  .btn-exe:active { box-shadow: none; transform: translate(2px,2px); }

  .row-end { display: flex; justify-content: flex-end; margin-top: 14px; }
  .row-between { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; }

  /* ── SCREEN 2: Scanner ── */
  .scan-alert {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 12px 14px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
    line-height: 1.5;
  }
  .scan-alert.warn   { background: #fff8e1; border: 1.5px solid #FFD54F; color: #7a5800; }
  .scan-alert.danger { background: #fce4ec; border: 1.5px solid #F48FB1; color: #880e4f; }
  .scan-alert.safe   { background: #e8f5e9; border: 1.5px solid #A5D6A7; color: #1b5e20; }
  .scan-alert.crisis {
    background: #3d0014;
    border: 2px solid #ff4d6d;
    color: #fff;
    border-radius: 10px;
    padding: 16px 16px;
    font-size: 14px;
    line-height: 1.7;
  }
  .scan-alert.crisis .crisis-title {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #ffb3c1;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .scan-alert.crisis .crisis-hotline {
    margin-top: 10px;
    background: rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.8;
  }
  .scan-alert.crisis .crisis-hotline strong {
    color: #ffd6e0;
  }
  .scan-alert .alert-icon { font-size: 20px; flex-shrink: 0; margin-top: 1px; }

  .scan-bar-wrap { margin-bottom: 18px; }
  .scan-bar-label { font-size: 12px; color: #888; margin-bottom: 5px; }
  .scan-bar { height: 8px; background: #eee; border-radius: 4px; overflow: hidden; }
  .scan-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--mint-deep), var(--pink-deep));
    border-radius: 4px;
    width: 0;
    transition: width 1.2s ease;
  }

  .checklist-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  @media(max-width: 460px) { .checklist-grid { grid-template-columns: 1fr; } }

  .check-item {
    display: flex; align-items: flex-start; gap: 8px;
    background: #fafafa;
    border: 1.5px solid #eee;
    border-radius: 8px;
    padding: 10px 10px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-size: 13px;
    color: #444;
    line-height: 1.45;
  }
  .check-item:hover { border-color: var(--pink-mid); background: #fff5f9; }
  .check-item.checked { border-color: var(--pink-deep); background: #fff0f6; }
  .check-item input[type=checkbox] { margin-top: 2px; accent-color: var(--pink-deep); flex-shrink: 0; }

  .detected-badge {
    display: inline-block;
    background: var(--pink-light);
    color: var(--pink-deep);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    margin-left: 6px;
    vertical-align: middle;
  }

  /* ── SCREEN 3: Browser ── */
  .browser-bar {
    display: flex; align-items: center; gap: 6px;
    background: #f0f0f0;
    border-bottom: 1px solid #ddd;
    padding: 7px 12px;
  }
  .browser-nav-btn {
    width: 22px; height: 22px;
    background: #ddd; border: none; border-radius: 50%;
    font-size: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    color: #666;
  }
  .browser-url {
    flex: 1;
    background: #fff;
    border: 1px solid #ccc;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    color: #2a6a2a;
    font-family: monospace;
  }

  .card-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
  @media(max-width:440px){ .card-duo { grid-template-columns:1fr; } }

  .card-before {
    background: #f7f7f7;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    padding: 14px;
    opacity: 0.7;
  }
  .card-after {
    background: linear-gradient(135deg, #fff0f6, #e8faf6);
    border: 1.5px solid var(--mint-mid);
    border-radius: 10px;
    padding: 14px;
  }
  .card-label { font-size: 11px; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 5px; }
  .card-before .card-label { color: #aaa; }
  .card-after  .card-label { color: var(--mint-deep); }
  .card-before-text { font-size: 13px; color: #aaa; line-height: 1.6; text-decoration: line-through; }
  .card-after textarea {
    width: 100%; min-height: 90px;
    border: none; outline: none; resize: none;
    background: transparent;
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 13px; line-height: 1.7; color: #333;
  }
  .card-after textarea::placeholder { color: #aac; }

  .inline-warn { font-size: 12px; color: #E8749A; margin-top: 4px; min-height: 18px; }

  .ai-suggest-btn {
    display: flex; align-items: center; gap: 6px;
    background: linear-gradient(90deg, #f3e8ff, #e8faf6);
    border: 1.5px solid var(--mint-mid);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px; color: #3a3a6a; cursor: pointer;
    width: 100%; justify-content: center;
    margin-bottom: 14px;
    transition: opacity 0.15s;
  }
  .ai-suggest-btn:hover { opacity: 0.8; }

  /* Popup / result card */
  .popup-bg {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 300;
    align-items: center; justify-content: center;
  }
  .popup-bg.show { display: flex; }
  .result-card {
    background: #fff;
    border-radius: 18px;
    padding: 28px 26px;
    width: min(440px, 92vw);
    box-shadow: 0 16px 60px rgba(0,0,0,0.22);
    animation: winOpen 0.28s cubic-bezier(.22,1,.36,1);
    text-align: center;
  }
  .result-card .ribbon {
    display: inline-block;
    background: linear-gradient(90deg, var(--pink-deep), var(--mint-deep));
    color: #fff;
    font-size: 11px; font-weight: 700;
    padding: 3px 14px; border-radius: 20px;
    margin-bottom: 14px; letter-spacing: 0.06em;
  }
  .result-card h2 { font-size: 18px; font-weight: 700; margin-bottom: 6px; color: #333; }
  .result-card .result-sub { font-size: 13px; color: #888; margin-bottom: 18px; }
  .result-sticker {
    background: linear-gradient(135deg, #fff0f6, #e8faf6);
    border: 2px dashed var(--mint-mid);
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 18px;
    text-align: left;
  }
  .sticker-row { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px; }
  .sticker-row:last-child { margin-bottom: 0; }
  .sticker-emoji { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
  .sticker-label { font-size: 11px; font-weight: 700; color: #aaa; margin-bottom: 3px; }
  .sticker-text  { font-size: 14px; color: #333; line-height: 1.6; }

  /* Taskbar */
  .taskbar {
    position: fixed; bottom: 0; left: 0; right: 0;
    height: 46px;
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255,255,255,0.8);
    display: flex; align-items: center;
    padding: 0 12px;
    gap: 8px;
    z-index: 100;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
  }
  .start-btn {
    background: linear-gradient(135deg, var(--pink-deep), var(--mint-deep));
    color: #fff;
    border: none; border-radius: 8px;
    padding: 5px 14px;
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 13px; font-weight: 700;
    cursor: pointer;
    display: flex; align-items: center; gap: 5px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.14);
  }
  .taskbar-divider { width: 1px; height: 24px; background: rgba(0,0,0,0.1); margin: 0 4px; }
  .taskbar-clock {
    margin-left: auto;
    font-size: 12px; color: #666;
    text-align: right;
    line-height: 1.3;
  }
  .taskbar-task {
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px; color: #555;
    cursor: pointer;
    display: flex; align-items: center; gap: 5px;
  }
  .taskbar-task.active-task { background: rgba(232,116,154,0.15); border-color: var(--pink-mid); color: var(--pink-deep); }

  /* Loading spinner */
  .spinner {
    width: 36px; height: 36px;
    border: 3px solid #eee;
    border-top-color: var(--pink-deep);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    margin: 20px auto;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .loading-text { text-align: center; font-size: 13px; color: #888; margin-bottom: 10px; }

  /* Section titles */
  .section-title { font-size: 12px; font-weight: 700; color: #888; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 8px; margin-top: 4px; }

  /* Utility */
  .mt8  { margin-top: 8px; }
  .mt12 { margin-top: 12px; }
  .mt16 { margin-top: 16px; }
  .small { font-size: 12px; color: #999; }
</style>
<style>
#wiz-bg{display:none;position:fixed;inset:0;background:rgba(255,182,211,.35);backdrop-filter:blur(3px);z-index:8}
#win-wizard{width:min(520px,96vw)}
.wiz-opt{display:flex;gap:12px;align-items:center;padding:10px 12px;margin-bottom:8px;border:1.5px solid #eee;border-radius:8px;cursor:pointer;background:#fafafa;transition:.15s}
.wiz-opt:hover{border-color:var(--mint-mid)}
.wiz-opt.sel{border-color:var(--pink-deep);background:#fff0f6}
.wiz-opt input{accent-color:var(--pink-deep)}
.wiz-opt b{font-size:14px;color:#333}.wiz-opt small{display:block;font-size:12px;color:#888}
.btn:disabled{opacity:.45;cursor:not-allowed}
.retro-dlg-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.25);z-index:700;align-items:center;justify-content:center}
.retro-dlg{width:min(410px,92vw);background:#f4f4f4;border:2px solid;border-color:#fff #888 #888 #fff;box-shadow:3px 3px 0 #999}
.retro-dlg-t{background:linear-gradient(90deg,var(--mint-deep),var(--pink-mid));color:#fff;font-size:12px;font-weight:700;padding:5px 8px}
.retro-dlg-b{display:flex;gap:12px;padding:16px;font-size:13px;line-height:1.65;color:#333}
#pb-banner{display:none;background:#e8faf6;border:1.5px solid var(--mint-mid);border-radius:8px;padding:8px 12px;font-size:12px;color:#1b6b5a;margin-bottom:10px}
#win3.path-b .card-before{opacity:1;background:linear-gradient(135deg,#e8faf6,#fff0f6);border-color:var(--mint-mid)}
#win3.path-b .card-before-text{text-decoration:none;color:#2a9d8f;font-weight:700;font-size:15px}
</style>
</head>
<body>

<!-- Desktop icons -->
<div class="desktop-icons">
  <div class="desktop-icon" onclick="showWindow(1)">
    <div class="icon-img">📝</div>
    <span>마음 기록</span>
  </div>
  <div class="desktop-icon" onclick="showWindow(2)" id="icon2" style="opacity:0.4;pointer-events:none">
    <div class="icon-img">🔍</div>
    <span>스캐너</span>
  </div>
  <div class="desktop-icon" onclick="showWindow(3)" id="icon3" style="opacity:0.4;pointer-events:none">
    <div class="icon-img">🌱</div>
    <span>리프레시</span>
  </div>
</div>

<!-- ══════════════════════════════════ SCREEN 1 ══════════════════════ -->
<div class="window" id="win1">
  <div class="win-titlebar pink" style="flex-direction:column;padding:8px 14px 0;gap:6px;">
    <div style="display:flex;align-items:center;width:100%;gap:8px;">
      <span class="win-title">📝 오늘의_마음_기록.txt</span>
      <div class="win-btns">
        <button class="win-btn minimize">_</button>
        <button class="win-btn maximize">□</button>
        <button class="win-btn close" onclick="resetAll()">✕</button>
      </div>
    </div>
    <div class="browser-bar" style="width:100%;margin:0 -14px;padding:7px 14px;border-radius:0;border-top:1px solid rgba(0,0,0,0.08);">
      <button class="browser-nav-btn">←</button>
      <button class="browser-nav-btn">→</button>
      <button class="browser-nav-btn">↻</button>
      <div class="browser-url">🔒 https://textherapy.com</div>
    </div>
  </div>
  <div class="win-body">

    <!-- NLP Banner -->
