async function aiSuggestPositive(forBlock = false) {
  const original = document.getElementById('user-input').value.trim();
  const checkedItems = getCheckedItems();
  const btn = document.querySelector('.ai-suggest-btn');

  if (!forBlock && btn) {
    btn.textContent = '✨ 확인 중...';
    btn.style.opacity = '0.6';
  }

  // AI로 입력 의미 판별
  const meaningful = await isInputMeaningful(original);

  // 의미없는 입력 + 체크리스트도 없으면 → 안내 + 버튼
  if (!meaningful && checkedItems.length === 0) {
    const blockBox = document.getElementById('block-box');
    blockBox.style.display = 'block';
    blockBox.innerHTML = `
      <div style="font-size:13px;font-weight:700;color:var(--pink-deep);margin-bottom:8px;">📝 마음을 조금 더 알려주세요</div>
      <div style="font-size:12px;color:#888;line-height:1.6;margin-bottom:12px;">
        입력하신 내용만으로는 마음을 파악하기 어려워요.<br>
        1단계로 돌아가서 생각을 조금 더 적거나,<br>
        2단계 체크리스트에서 해당되는 항목을 체크해주세요.
      </div>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-pink" style="flex:1;" onclick="showWindow(1)">← 1단계로 돌아가기</button>
        <button class="btn btn-ghost" style="flex:1;" onclick="showWindow(2)">체크리스트 하러 가기</button>
      </div>
    `;
    if (!forBlock && btn) {
      btn.textContent = '✨ AI 긍정 생각 제안받기 — 막막하다면 클릭!';
      btn.style.opacity = '1';
    }
    return;
  }

  if (!forBlock && btn) {
    btn.textContent = '✨ 생각 생성 중...';
  }

  const prevSuggestions = window._prevSuggestions || [];

  // 컨텍스트: 의미있는 원문 + 체크리스트 조합
  let contextPart = '';
  if (meaningful && original) contextPart += `[마음 기록]: ${original.replace(/"/g,"'")}`;
  if (checkedItems.length > 0) {
    if (contextPart) contextPart += '\n';
    contextPart += `[자가진단 체크 항목]: ${checkedItems.join(' / ')}`;
  }

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 300,
        messages: [{
          role: 'user',
          content: `당신은 청소년 심리 전문 상담사입니다. 아래 정보를 바탕으로 인지행동치료(CBT) 원리로 건강하게 전환한 문장을 1개 만들어주세요.

${contextPart}

규칙:
- 완성된 문장 1개만 출력하세요. 따옴표, 설명, 인사말 절대 금지.
- 아래 이전 제안들과 완전히 다른 표현과 구조를 사용하세요.
- 마음 기록이 짧거나 불명확한 경우, 체크된 자가진단 항목을 중심으로 문장을 만드세요.
- "~할 수 있어", "~괜찮아", "~나아갈 수 있어" 등 동일한 결말 패턴을 반복하지 마세요.
- 청소년이 실제로 쓸 법한 자연스러운 한국어로, 현실적으로 작성하세요.
- 다양한 접근: 자기 수용 / 성장 관점 / 현재에 집중 / 관계 재해석 / 작은 성공 인정 중 선택하세요.

이전 제안들 (이것들과 달라야 함): ${prevSuggestions.length ? prevSuggestions.join(' / ') : '없음'}`
        }]
      })
    });
    const data = await res.json();
    const raw = data.content.map(b => b.text || '').join('').trim();
    const suggestion = raw.replace(/^["'"""''\-—–\s]+|["'"""''\-—–\s]+$/g, '').trim();

    prevSuggestions.push(suggestion);
    if (prevSuggestions.length > 5) prevSuggestions.shift();
    window._prevSuggestions = prevSuggestions;

    if (forBlock) {
      document.getElementById('suggest-preview').textContent = suggestion;
      window._currentSuggestion = suggestion;
    } else {
      document.getElementById('new-thought-input').value = suggestion;
      checkNegative();
    }
  } catch(e) {
    const fallbacks = [
      '오늘 이 순간도 버텨낸 나 자신을 조금은 인정해줄 수 있어.',
      '완벽하지 않아도 괜찮아. 지금 이 자리에 있는 것만으로도 충분해.',
      '이 상황이 영원히 이어지지는 않을 거야. 조금씩 달라질 수 있어.',
      '지금 느끼는 감정은 진짜이지만, 그게 미래를 결정하지는 않아.',
      '실수해도 돼. 그게 사람이 자라는 방식이니까.'
    ];
    const fb = fallbacks[Math.floor(Math.random() * fallbacks.length)];
    if (forBlock) {
      document.getElementById('suggest-preview').textContent = fb;
      window._currentSuggestion = fb;
    } else {
      document.getElementById('new-thought-input').value = fb;
    }
  }

  if (!forBlock && btn) {
    btn.textContent = '✨ AI 긍정 생각 제안받기 — 막막하다면 클릭!';
    btn.style.opacity = '1';
  }
}

