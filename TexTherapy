let negCheckTimer = null;

function checkNegative() {
  const val = document.getElementById('new-thought-input').value;
  const found = negKeywords.filter(k => val.includes(k));
  if (!found.length) {
    document.getElementById('neg-warn').textContent = '';
    return;
  }
  clearTimeout(negCheckTimer);
  negCheckTimer = setTimeout(() => aiRecheck(val, found[0]), 800);
}

async function aiRecheck(text, triggeredKw) {
  const warn = document.getElementById('neg-warn');

  // 위기 키워드가 트리거된 경우 — AI로 문맥 확인
  const isCrisisKw = crisisKeywords.some(kw => text.includes(kw));
  if (isCrisisKw) {
    try {
      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 10,
          messages: [{
            role: 'user',
            content: `다음 문장이 자해·자살·삶을 끝내고 싶은 감정을 직접 표현하고 있나요? "예" 또는 "아니오"만 출력하세요.\n\n문장: "${text.replace(/"/g,"'")}"`
          }]
        })
      });
      const d = await res.json();
      const cv = d.content.map(b => b.text || '').join('').trim();
      if (cv.includes('예')) {
        warn.innerHTML = `🚨 위로 카드에는 이런 표현을 담을 수 없어요.<br>
          <span style="font-size:12px;line-height:1.8;display:block;margin-top:4px;">
            지금 많이 힘드신가요? 혼자 버티지 않아도 돼요.<br>
            <strong>자살예방상담전화 1393</strong> / <strong>청소년전화 1388</strong> (24시간 무료)
          </span>`;
        warn.style.color = '#c0002a';
        return;
      }
    } catch(e) {
      // 연결 실패 시 위기로 간주
      warn.innerHTML = `🚨 위로 카드에는 이런 표현을 담을 수 없어요.<br>
        <span style="font-size:12px;line-height:1.8;display:block;margin-top:4px;">
          지금 많이 힘드신가요? 혼자 버티지 않아도 돼요.<br>
          <strong>자살예방상담전화 1393</strong> / <strong>청소년전화 1388</strong> (24시간 무료)
        </span>`;
      warn.style.color = '#c0002a';
      return;
    }
  }

  // 일반 부정어 — 문맥 긍/부정 확인
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 10,
        messages: [{
          role: 'user',
          content: `다음 문장이 전체적으로 긍정적인 내용인지 부정적인 내용인지 판단해주세요. "긍정" 또는 "부정" 중 하나의 단어만 출력하세요.\n\n문장: "${text.replace(/"/g,"'")}"`
        }]
      })
    });
    const data = await res.json();
    const verdict = data.content.map(b => b.text || '').join('').trim();
    if (verdict.includes('부정')) {
      warn.style.color = '';
      warn.textContent = `💛 "${triggeredKw}" 같은 표현이 들어가 있어요. 조금 더 부드럽게 바꿔볼까요?`;
    } else {
      warn.style.color = '';
      warn.textContent = '';
    }
  } catch(e) {
    warn.style.color = '';
