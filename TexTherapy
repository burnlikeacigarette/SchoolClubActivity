<script>
(function(){
const $=id=>document.getElementById(id);
const CATS=[
 {k:'A',i:'📘',n:'학업/진로',t:'학업 및 진로',d:'성적, 시험, 미래 고민'},
 {k:'A',i:'👥',n:'대인관계',t:'대인 관계 및 학교생활',d:'친구, 선생님, 교우관계'},
 {k:'A',i:'🏠',n:'가정/개인',t:'가정 및 개인적 문제',d:'가족, 자존감, 개인적 스트레스'},
 {k:'A',i:'🌀',n:'기타',t:'기타',d:'명확하지 않은 답답한 마음'},
 {k:'B',i:'✨',n:'고민 없음',t:'고민 없음 / 오늘 마음 편함',d:'기분 최고!'}];
let sel=null,track='A',scanNames=[];
const BLOCK=$('block-box').innerHTML;
const FB=['오늘 내가 건넨 작은 친절이 내일의 행운이 되어 돌아올 거야.','지금 이 좋은 기분처럼, 오늘 하루도 나답게 반짝여 보자.','해보고 싶던 일에 한 걸음만 내디뎌 보기로 다짐해!','오늘의 나에게 수고했다고, 정말 잘하고 있다고 말해 줄래.'];
const restoreBlock=()=>{const b=$('block-box');b.innerHTML=BLOCK;b.style.display='none';};

/* ── 데이터 수집 (localStorage 누적, 고민 원문은 저장하지 않음) ── */
function rec(sentence){
  const A=track==='A';
  const r={datetime:fmt(new Date()),category:CATS[sel==null?3:sel].n,checkedItems:A?getCheckedItems():[],patterns:A?[...scanNames]:[],finalSentence:sentence,track};
  window.exhibitionData.push(r);save();
  console.log('[TexTherapy 수집 #'+window.exhibitionData.length+']',r);
}

/* ── 마법사 ── */
$('wiz-opts').innerHTML=CATS.map((c,i)=>`<label class="wiz-opt" id="wo${i}"><input type="radio" name="wz" onchange="wizPick(${i})"><span style="font-size:22px">${c.i}</span><span><b>${c.t}</b><small>${c.d}</small></span></label>`).join('');
window.wizPick=i=>{sel=i;CATS.forEach((_,j)=>$('wo'+j).classList.toggle('sel',j===i));$('wiz-next').disabled=false;};
window.openWizard=function(){
  sel=null;track='A';scanNames=[];window._done=false;
  document.querySelectorAll('input[name=wz]').forEach(r=>r.checked=false);
  CATS.forEach((_,j)=>$('wo'+j).classList.remove('sel'));$('wiz-next').disabled=true;
  ['win1','win2','win3'].forEach(i=>$(i).classList.remove('active'));
  ['task1','task2','task3'].forEach(i=>$(i).style.display='none');
  ['icon2','icon3'].forEach(i=>{$(i).style.opacity='.4';$(i).style.pointerEvents='none';});
  $('win-home').classList.remove('active');const w=$('win-wizard');w.classList.add('active');Object.assign(w.style,{left:'50%',top:'50%',transform:'translate(-50%,-50%)'});
  $('wiz-bg').style.display='block';
};
function applyTrackUI(){
  const B=track==='B',w=$('win3'),q=s=>w.querySelector(s);
  w.classList.toggle('path-b',B);
  q('.section-title').textContent=B?'오늘의 다짐 카드 — 소원 남기기':'생각 전환 — 오래된 파일 교체하기';
  q('.card-before .card-label').textContent=B?'🌤️ 오늘의 기분':'🗑️ 수정 전 오류 생각';
  q('.card-after .card-label').textContent=B?'🌱 오늘의 다짐 · 소원':'🌱 새로운 건강한 생각';
  q('#new-thought-input').placeholder=B?'오늘을 기분 좋게 보낼 다짐이나 소원, 나에게 할 응원의 한마디를 적어보세요':'더 부드럽고 현실적인 생각을 적어봐요...';
  q('.btn-pink').textContent=B?'💌 소원 카드 완성':'💌 위로 카드 완성';
  const bk=q('.row-between .btn-ghost');bk.textContent=B?'← 분야 다시 선택':'← 다시 스캔';bk.onclick=B?window.openWizard:()=>showWindow(2);
  $('pb-banner').style.display=B?'block':'none';
  const i1=document.querySelector('.desktop-icon');i1.style.opacity=B?.4:1;i1.style.pointerEvents=B?'none':'auto';
}
$('win3').querySelector('.section-title').insertAdjacentHTML('beforebegin','<div id="pb-banner">✅ 마음 시스템 상태: 이상 없음 (Clean) · 오늘의 긍정 에너지를 카드에 담아보세요</div>');
window.wizNext=function(){
  if(sel==null)return;
  $('win-wizard').classList.remove('active');$('wiz-bg').style.display='none';
  track=CATS[sel].k;applyTrackUI();window._prevSuggestions=[];
  if(track==='A'){$('task1').style.display='flex';showWindow(1);return;}
  const t='오늘의 기분: 최고! ✨';$('user-input').value=t;$('old-thought-display').textContent=t;
  $('new-thought-input').value='';const nw=$('neg-warn');nw.innerHTML='';nw.style.color='';restoreBlock();
  $('icon3').style.opacity='1';$('icon3').style.pointerEvents='auto';$('task3').style.display='flex';
  showWindow(3);$('pb-alert').style.display='flex';
};

/* ── 기존 함수 확장 ── */
const wrap=(n,f)=>{const o=window[n];window[n]=function(...a){return f(o,...a);};};
wrap('resetAll',(o)=>{o();restoreBlock();window.openWizard();});
wrap('goToStep3',(o)=>{const p=o();restoreBlock();return p;});   // 기존 코드가 block-box를 비워 추천 박스가 깨지던 문제 복구
wrap('showResult',(o)=>{if(!$('suggest-preview'))restoreBlock();return o();});
wrap('highlightDetected',(o,p)=>{scanNames=[...new Set((p||[]).filter(x=>x&&x!=='분석 완료'))];return o(p);});
wrap('runScan',async(o)=>{scanNames=[];await o();if(!scanNames.length)scanNames=localScan($('user-input').value.trim()).map(p=>p.label);});
wrap('proceedToResult',async(o,t)=>{
  if(window._done)return;window._done=true;      // 중복 기록 방지
  const B=track==='B';rec(t);
  const po=$('popup-old');po.style.textDecoration=B?'none':'line-through';po.style.color=B?'#2a7a5a':'#bbb';
  const sl=document.querySelectorAll('#result-popup .sticker-label');
  sl[0].textContent=B?'오늘의 기분':'버려진 생각';sl[1].textContent=B?'오늘의 다짐 · 소원':'새로 심은 생각';
  document.querySelector('#result-popup .sticker-emoji').textContent=B?'🌤️':'🗑️';
  await o(t);
  if(B)$('popup-ai-msg').textContent='오늘의 다짐을 마음에 새긴 것만으로도 하루가 한결 단단해질 거예요. 좋은 기운이 계속 이어지길 응원해요 🌈';
});
wrap('savePersonal',(o)=>{o();const c=window._personalCards;if(track==='B'&&c&&c[0])c[0].b=1;});
wrap('renderPersonal',(o)=>{o();const c=window._personalCards||[];
  document.querySelectorAll('#personal-grid .personal-card').forEach((e,i)=>{if(c[i]&&c[i].b){const d=e.children[1];d.textContent='🌤️ 오늘의 기분: 최고!';d.style.textDecoration='none';d.style.color='#2a9d8f';}});});
/* Path B: AI 프롬프트 분기 — 부정 전환이 아닌 긍정 메시지/다짐 생성 */
wrap('aiSuggestPositive',async(o,forBlock=false)=>{
  if(track!=='B')return o(forBlock);
  const btn=document.querySelector('.ai-suggest-btn'),prev=window._prevSuggestions||[];
  if(!forBlock&&btn){btn.textContent='✨ 생성 중...';btn.style.opacity='.6';}
  let s='';
  try{
    const r=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:200,messages:[{role:'user',content:`청소년이 기분 좋은 날 카드에 적을 "오늘 하루의 긍정 기운을 더해주는 따뜻한 행운의 메시지나 멋진 다짐 문장"을 1개 만드세요.\n규칙: 문장 1개만 출력, 따옴표·설명·인사말 금지, 자연스러운 한국어, 다짐/행운/응원/소원 중 매번 다른 관점으로, 아래 이전 문장들과 다르게.\n이전: ${prev.join(' / ')||'없음'}`}]})});
    const d=await r.json();s=d.content.map(b=>b.text||'').join('').trim().replace(/^["'\u201c\u201d\u2018\u2019\s]+|["'\u201c\u201d\u2018\u2019\s]+$/g,'');
  }catch(e){}
  if(!s)s=FB[Math.floor(Math.random()*FB.length)];
  prev.push(s);if(prev.length>5)prev.shift();window._prevSuggestions=prev;
  if(forBlock){$('suggest-preview').textContent=s;window._currentSuggestion=s;}
  else{$('new-thought-input').value=s;checkNegative();}
  if(!forBlock&&btn){btn.textContent='✨ AI 긍정 생각 제안받기 — 막막하다면 클릭!';btn.style.opacity='1';}
});

window.openHome=function(){
  window._done=false;sel=null;track='A';scanNames=[];
  ['win-wizard','win1','win2','win3'].forEach(i=>$(i).classList.remove('active'));
  ['win-board','win-personal'].forEach(i=>$(i).style.display='none');
  ['task1','task2','task3'].forEach(i=>$(i).style.display='none');
  $('pb-alert').style.display='none';$('result-popup').classList.remove('show');
  const h=$('win-home');h.classList.add('active');Object.assign(h.style,{left:'50%',top:'50%',transform:'translate(-50%,-50%)'});
  $('wiz-bg').style.display='block';
};
window.startFromHome=function(){window.openWizard();};
window.goHome=function(){window.resetAll();window.openHome();};
/* ── 관리자 모드 ── */
const PW='14701224',KEY='textherapy-admin-data';
const p2=x=>String(x).padStart(2,'0');
window.fmt=n=>`${n.getFullYear()}-${p2(n.getMonth()+1)}-${p2(n.getDate())} ${p2(n.getHours())}:${p2(n.getMinutes())}:${p2(n.getSeconds())}`;
const fmt=window.fmt;
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(window.exhibitionData))}catch(e){}};
try{window.exhibitionData=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){window.exhibitionData=[]}
const esc=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const tally=a=>{const m={};a.forEach(x=>m[x]=(m[x]||0)+1);return Object.entries(m).sort((x,y)=>y[1]-x[1]);};
function dlg(t,b,ok,cb,cancel){
  $('adm-dt').textContent=t;$('adm-db').innerHTML=b;$('adm-cancel').style.display=cancel?'':'none';$('adm-ok').textContent=ok||'확인';
  $('adm-dlg').style.display='flex';const close=()=>$('adm-dlg').style.display='none';
  $('adm-ok').onclick=()=>{if(cb)cb();close();};$('adm-cancel').onclick=close;
  const i=$('adm-pw');if(i){i.focus();i.onkeydown=e=>{if(e.key==='Enter')$('adm-ok').click();};}
}
function ask(title,msg,fn){
  dlg(title,`<div style="font-size:30px">🔐</div><div>${msg}<br><input id="adm-pw" type="password" autocomplete="off" style="margin-top:6px;padding:6px;border:1px solid #999;width:100%"></div>`,'확인',()=>{
    const ok=$('adm-pw').value===PW;
    setTimeout(()=>ok?fn():dlg('⚠️ 오류','<div style="font-size:30px">❌</div><div>비밀번호가 올바르지 않습니다.</div>'),0);
  },true);
}
let tab='s';
function gauge(l,v,pct,c){return `<div class="ag"><div class="agl"><span>${l}</span><b>${v}</b></div><div class="agb"><i style="width:${pct}%;background:${c}"></i></div></div>`;}
function render(){
  const d=window.exhibitionData,n=d.length,A=d.filter(r=>r.track==='A'),a=A.length;
  const pa=n?Math.round(a/n*100):0,td=fmt(new Date()).slice(0,10),tn=d.filter(r=>r.datetime.slice(0,10)===td).length;
  let h=`<div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap"><button class="btn ${tab==='s'?'btn-pink':'btn-ghost'}" onclick="admTab('s')">📊 실시간 통계</button><button class="btn ${tab==='l'?'btn-pink':'btn-ghost'}" onclick="admTab('l')">📋 누적 데이터 로그</button></div>`;
  if(tab==='s'){
    if(!n)h+='<div class="acard" style="text-align:center;color:#999">아직 수집된 데이터가 없어요.</div>';
    else{
      const C=['#E8749A','#3BBFAD','#F6B26B','#9B8CE0'],names=['학업/진로','대인관계','가정/개인','기타'];
      const cat=names.map(k=>[k,A.filter(r=>r.category===k).length]);let acc=0;
      const pie=a?cat.map((c,i)=>{const s0=acc;acc+=c[1]/a*100;return `${C[i]} ${s0}% ${acc}%`}).join(','):'#eee 0 100%';
      const pt=tally(d.flatMap(r=>r.patterns)),pn=pt.reduce((s0,x)=>s0+x[1],0),ck=tally(d.flatMap(r=>r.checkedItems)).slice(0,3);
      h+=`<div class="acard" style="background:linear-gradient(90deg,#fff0f7,#e8faf6)"><div style="font-size:15px;line-height:1.7">총 <b style="color:var(--pink-deep)">${n}명</b>이 참여했으며(오늘 ${tn}명),<br>고민이 있는 학생 <b>${pa}%</b>, 고민이 없는 학생 <b>${n?100-pa:0}%</b></div></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
      <div class="acard" style="flex:1;min-width:280px"><h4>🥧 고민 분야 분포 (고민 있는 ${a}명 기준)</h4><div style="display:flex;gap:14px;align-items:center"><div style="width:120px;height:120px;border-radius:50%;flex-shrink:0;background:conic-gradient(${pie})"></div><div style="flex:1">${cat.map((c,i)=>gauge(c[0],`${a?Math.round(c[1]/a*100):0}% (${c[1]}명)`,a?c[1]/a*100:0,C[i])).join('')}</div></div></div>
      <div class="acard" style="flex:1;min-width:280px"><h4>🧠 가장 많이 감지된 사고 패턴 Top 5</h4>${pt.length?pt.slice(0,5).map((x,i)=>gauge((['🥇','🥈','🥉'][i]||(i+1)+'위')+' '+esc(x[0]),`${Math.round(x[1]/pn*100)}% (${x[1]}회)`,x[1]/pn*100,C[i%4])).join(''):'<span style="color:#999;font-size:12px">감지된 패턴이 없어요.</span>'}</div></div>
      <div class="acard"><h4>✅ 가장 많이 체크된 자가진단 문항 Top 3</h4>${ck.length?ck.map((x,i)=>`<div style="font-size:12px;margin-bottom:5px">${['🥇','🥈','🥉'][i]} ${esc(x[0])} <b>(${x[1]}회)</b></div>`).join(''):'<span style="color:#999;font-size:12px">체크된 문항이 없어요.</span>'}</div>`;
    }
  }else{
    h+=`<div style="display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap"><button class="btn btn-teal" style="padding:7px 12px;font-size:12px" onclick="admDl('csv')">📥 CSV 백업</button><button class="btn btn-teal" style="padding:7px 12px;font-size:12px" onclick="admDl('json')">📥 JSON 백업</button><button class="btn btn-ghost" style="padding:7px 12px;font-size:12px" onclick="admReset()">🗑️ 전체 데이터 초기화</button><span style="font-size:12px;color:#999;align-self:center">총 ${n}건 · 고민 원문은 저장되지 않아요</span></div>
    <div style="max-height:46vh;overflow:auto;border:1px solid #eee;border-radius:6px"><table class="at"><tr><th>일시</th><th>카테고리</th><th>트랙</th><th>사고패턴</th><th>체크문항</th><th>최종 위로문장</th></tr>${n?[...d].reverse().map(r=>`<tr><td>${esc(r.datetime)}</td><td>${esc(r.category)}</td><td>${r.track==='A'?'A 고민교정':'B 쾌속'}</td><td>${esc(r.patterns.join(', ')||'-')}</td><td>${esc(r.checkedItems.join(' / ')||'-')}</td><td>${esc(r.finalSentence)}</td></tr>`).join(''):'<tr><td colspan="6" style="text-align:center;color:#999">기록이 없어요.</td></tr>'}</table></div>`;
  }
  $('adm-body').innerHTML=h;
}
window.admTab=t=>{tab=t;render();};
window.admDl=type=>{
  const d=window.exhibitionData,day=fmt(new Date()).slice(0,10);let txt,mime;
  if(type==='json'){txt=JSON.stringify(d,null,2);mime='application/json';}
  else{const q=x=>'"'+String(x).replace(/"/g,'""')+'"';mime='text/csv';
    txt='\ufeff일시,카테고리,트랙,사고패턴,체크문항,최종 위로문장\n'+d.map(r=>[q(r.datetime),q(r.category),r.track,q(r.patterns.join(' | ')),q(r.checkedItems.join(' | ')),q(r.finalSentence)].join(',')).join('\n');}
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([txt],{type:mime+';charset=utf-8'}));a.download=`textherapy-data-${day}.${type}`;document.body.appendChild(a);a.click();a.remove();
};
window.admReset=()=>ask('🗑️ [2차 비밀번호 확인]',`누적된 ${window.exhibitionData.length}건이 모두 삭제돼요.<br>관리자 비밀번호를 다시 입력하세요`,()=>{window.exhibitionData=[];save();render();showToast('🗑️ 데이터를 초기화했어요','pink');});
function openAdmin(){
  render();const w=$('win-admin');w.classList.add('active');Object.assign(w.style,{left:'50%',top:'50%',transform:'translate(-50%,-50%)'});
  setTimeout(()=>window._bindDrag&&window._bindDrag(),50);
}
window.adminOpen=()=>ask('🔐 [관리자 인증 v1.0]','관리자 비밀번호를 입력하세요',openAdmin);
window.adminClose=()=>$('win-admin').classList.remove('active');

window.openHome();
})();
</script>
